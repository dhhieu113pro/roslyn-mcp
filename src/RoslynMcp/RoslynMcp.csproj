<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>RoslynMcp</AssemblyName>
    <RootNamespace>RoslynMcp</RootNamespace>
    <PackageId>RoslynMcp.Dnx</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Title>Roslyn MCP Server</Title>
    <Authors>dhhieu113</Authors>
    <Description>An MCP 2.0 server providing semantic C# and Roslyn tools.</Description>
    <PackageTags>mcp;model-context-protocol;roslyn;csharp;code-analysis;dnx</PackageTags>
    <PackageProjectUrl>https://github.com/dhhieu113pro/roslyn-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dhhieu113pro/roslyn-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>RoslynMcp</ToolCommandName>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus-LGPL" Version="4.5.3.13" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
    <PackageReference Include="RoslynMcp.Core" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include=".mcp/server.json" Pack="false" />
    <None Include="$(IntermediateOutputPath)mcp/server.json" Pack="true" PackagePath="/.mcp/" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateMcpServerManifest" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <McpServerManifestSource>$(MSBuildProjectDirectory)/.mcp/server.json</McpServerManifestSource>
      <McpServerManifestDirectory>$(IntermediateOutputPath)mcp</McpServerManifestDirectory>
      <McpServerManifestOutput>$(McpServerManifestDirectory)/server.json</McpServerManifestOutput>
      <McpServerManifestContent>$([System.IO.File]::ReadAllText('$(McpServerManifestSource)'))</McpServerManifestContent>
      <McpServerManifestContent>$(McpServerManifestContent.Replace('&quot;version&quot;: &quot;0.0.0-placeholder&quot;', '&quot;version&quot;: &quot;$(Version)&quot;'))</McpServerManifestContent>
    </PropertyGroup>
    <MakeDir Directories="$(McpServerManifestDirectory)" />
    <WriteLinesToFile File="$(McpServerManifestOutput)" Lines="$(McpServerManifestContent)" Overwrite="true" />
  </Target>

</Project>
